# On first launch, the runner creates a random APP_SECRET in .env.
# Keep that value when restoring data: it encrypts keys and peppers passwords.
APP_SECRET=replace-with-a-random-value-of-at-least-32-characters
DATABASE_PATH=data/app.sqlite3
PUBLIC_ORIGIN=http://127.0.0.1:8767
# Optional; you can instead save the key in the admin UI.
OPENROUTER_API_KEY=
